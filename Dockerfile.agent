FROM ghcr.io/zeroclaw-labs/zeroclaw:latest AS zeroclaw-bin

FROM debian:trixie-slim
ARG AGENT_NAME

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl python3 gettext-base \
    && rm -rf /var/lib/apt/lists/*

COPY --from=zeroclaw-bin /usr/local/bin/zeroclaw /usr/local/bin/zeroclaw

ENV LANG=C.UTF-8
ENV HOME=/zeroclaw-data

COPY workspaces/${AGENT_NAME}/ /workspace/
COPY configs/${AGENT_NAME}.toml /workspace/config.template.toml
COPY scripts/agent-entry.sh /usr/local/bin/agent-entry.sh
RUN chmod +x /usr/local/bin/agent-entry.sh \
    && mkdir -p /zeroclaw-data/.zeroclaw \
    && chown -R 65534:65534 /workspace /zeroclaw-data
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/agent-entry.sh"]
