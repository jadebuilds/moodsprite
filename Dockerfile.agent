FROM zeroclaw:dev
ARG AGENT_NAME
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 gettext-base \
    && rm -rf /var/lib/apt/lists/*
COPY workspaces/${AGENT_NAME}/ /workspace/
COPY configs/${AGENT_NAME}.toml /workspace/config.template.toml
COPY scripts/agent-entry.sh /usr/local/bin/agent-entry.sh
RUN chmod +x /usr/local/bin/agent-entry.sh \
    && mkdir -p /zeroclaw-data/.zeroclaw \
    && chown -R 65534:65534 /workspace /zeroclaw-data
USER 65534:65534
ENTRYPOINT ["/usr/local/bin/agent-entry.sh"]
