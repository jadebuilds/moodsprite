# Signal phone numbers (E.164 format)
GHOSTWHEEL_PHONE=+1XXXXXXXXXX
AYA_PHONE=+1XXXXXXXXXX
ALASTAIR_PHONE=+1XXXXXXXXXX

# Signal group ID (base64, from setup-signal-group.sh)
SIGNAL_GROUP_ID=

# Signal API URLs are set per-service in docker-compose.yml
# These are only needed if running outside Docker:
# SIGNAL_API_URL_GHOSTWHEEL=http://localhost:8081
# SIGNAL_API_URL_AYA=http://localhost:8082
# SIGNAL_API_URL_ALASTAIR=http://localhost:8083

# Ollama (set per-service in docker-compose.yml)
# OLLAMA_URL=http://localhost:11434
